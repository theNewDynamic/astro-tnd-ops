{
  "name": "@thenewdynamic/astro-tnd-ops",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Astro integration that lets TND Ops read a site: publishes /.well-known/tnd.json at build time. Installed from GitHub, not npm.",
  "author": "The New Dynamic",
  "license": "MIT",
  "homepage": "https://github.com/theNewDynamic/astro-tnd-ops",
  "repository": {
    "type": "git",
    "url": "https://github.com/theNewDynamic/astro-tnd-ops.git"
  },
  "bugs": {
    "url": "https://github.com/theNewDynamic/astro-tnd-ops/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "tnd-ops"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "astro": "^7.4.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  }
}
